RewriteEngine On

# Accueil
RewriteRule ^$ 01-html/index.html [L]

# Pages sans extension .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)$ 01-html/$1.html [L,QSA]

# Compatibilité avec les anciennes URL en .html
RewriteCond %{THE_REQUEST} \s/+([^/]+)\.html[\s?] [NC]
RewriteRule ^([^/]+)\.html$ /$1 [R=301,L]
RewriteEngine On

# Forcer la version www
RewriteCond %{HTTP_HOST} ^triedreofficiel\.com$ [NC]
RewriteRule ^(.*)$ https://www.triedreofficiel.com/$1 [R=301,L]

# Accueil
RewriteRule ^$ 01-html/index.html [L]

# Pages sans extension .html
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^([^/.]+)$ 01-html/$1.html [L,QSA]

# Pages sans extension dans le dossier 01-html (ex. /01-html/membre)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/01-html/$1.html -f
RewriteRule ^01-html/([^/.]+)$ 01-html/$1.html [L,QSA]

# Compatibilité avec les anciennes URL en .html
RewriteCond %{THE_REQUEST} \s/+([^/]+)\.html[\s?] [NC]
RewriteRule ^([^/]+)\.html$ /$1 [R=301,L]

# ----------------------------------------------------------
# Cache contrôlé pendant le développement
# ----------------------------------------------------------

<IfModule mod_headers.c>

  # HTML : toujours vérifier s'il existe une version plus récente
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # CSS et JavaScript : revalidation systématique
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

</IfModule>

# TRIÈDRE — interdire tout accès HTTP aux fichiers de configuration PHP
<FilesMatch "^config(?:\.example|\[[0-9]+\])?\.php$">
    Require all denied
</FilesMatch>

# Images WebP : type MIME explicite (sécurité si le serveur ne le connaît pas)
AddType image/webp .webp
